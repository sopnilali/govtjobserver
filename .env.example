# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bd_govt_jobs?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="bdjobs_token"
ADMIN_EMAIL="admin@bdjobs.gov.bd"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Site Administrator"

# App
PORT=4000
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:4000,http://localhost:3000"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Storage - S3-compatible object storage (optional; falls back to local disk)
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET=""
